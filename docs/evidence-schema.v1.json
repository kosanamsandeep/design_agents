{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/legacy-lens/evidence/v1.json",
  "title": "Legacy Lens Evidence Model v1",
  "$comment": "DRAFT v1.0.0. Do not freeze until docs/contract_tests.py passes. JSON Schema enforces shape; docs/validate_evidence.py enforces referential integrity, coverage arithmetic, and conflict resolution references.",
  "description": "Language-neutral, versioned evidence model for recovered HLD/LLD. Tool outputs are adapters into this model, not truth. Stable IDs are assigned deterministically by the adapter. Conflicting claims are retained as claim records and resolved by the written conflict rule; they are never silently overwritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "entities",
    "edges",
    "coverage",
    "conflicts",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": [
        "extracted",
        "inferred",
        "hypothesis"
      ],
      "description": "Epistemic status of a claim, not a measure of correctness or completeness. extracted = directly observed by a parser/indexer; inferred = derived by a deterministic rule or join; hypothesis = proposed by an LLM/agent or unresolved."
    },
    "entity_kind": {
      "type": "string",
      "enum": [
        "repository",
        "module",
        "package",
        "file",
        "class",
        "interface",
        "enum",
        "field",
        "property",
        "function",
        "method",
        "route",
        "table",
        "queue",
        "topic",
        "service",
        "container",
        "datastore",
        "external_system"
      ]
    },
    "edge_kind": {
      "type": "string",
      "enum": [
        "imports",
        "calls",
        "implements",
        "extends",
        "reads",
        "writes",
        "publishes",
        "subscribes",
        "routes_to",
        "deploys",
        "depends_on",
        "contains",
        "uses"
      ]
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "source_span",
        "config",
        "runtime_trace",
        "repository_metadata",
        "external"
      ],
      "description": "source_span requires a line span; config/repository_metadata may cite a whole file; runtime_trace may cite a trace artifact; external may cite a vendor document."
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_col": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end_col": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "type",
        "path",
        "commit"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/evidence_type"
        },
        "extractor": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)",
          "description": "Repository-relative POSIX path; no leading slash. The semantic validator also rejects backslashes and './'. Runtime traces may use a synthetic path such as runtime://trace-id."
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "snippet_hash": {
          "type": "string",
          "description": "Hash of the cited snippet, for drift detection."
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "source_span"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "span"
            ]
          }
        }
      ]
    },
    "claim_value": {
      "type": "object",
      "additionalProperties": true,
      "description": "The tool-specific value under dispute. Keep it small and typed where possible."
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "tool",
        "value"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim:.+$",
          "description": "Stable ID for this claim within the conflict. resolutions.chosen must reference this value."
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/claim_value"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "root"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "root": {
          "type": "string"
        },
        "vcs": {
          "type": "string",
          "default": "git"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+:.+$",
          "description": "Stable, adapter-assigned ID. Recommended form: '<kind>:<language>:<repo-relative-path>#<qualified-name>' for code entities, '<kind>:<canonical-name>' for external systems. Never use array indexes or display names alone."
        },
        "kind": {
          "$ref": "#/$defs/entity_kind"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualified_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository-relative POSIX path."
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Previous IDs or alternate names for rename/move tracking. The primary ID does not change silently."
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true,
          "description": "Kind-specific data, e.g. route method/path, table schema, deploy unit, queue name. Document tool-specific keys."
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+:.+$",
          "description": "Stable edge ID, preferably '<edge>:<from>|<kind>|<to>' percent-encoded or hashed."
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/edge_kind"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true,
          "description": "Kind-specific data, e.g. HTTP method, topic name, SQL operation."
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_total",
        "files_analyzed",
        "files_skipped",
        "entry_points_identified",
        "data_stores_identified",
        "unknowns_count"
      ],
      "description": "files_analyzed and files_skipped are mutually exclusive and exhaustive: their sum must equal files_total. unknowns_count must equal the length of the top-level unknowns array. docs/validate_evidence.py enforces both invariants.",
      "properties": {
        "files_total": {
          "type": "integer",
          "minimum": 0
        },
        "files_analyzed": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "entry_points_identified": {
          "type": "integer",
          "minimum": 0
        },
        "data_stores_identified": {
          "type": "integer",
          "minimum": 0
        },
        "unknowns_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "claims",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "subject": {
          "type": "string",
          "description": "Entity or edge ID about which tools disagree."
        },
        "claims": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unresolved",
            "resolved"
          ]
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ],
          "description": "claim_id of the chosen claim; null when unresolved."
        },
        "by": {
          "type": "string",
          "enum": [
            "rule",
            "human",
            "verifier",
            "agent"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "Named, versioned resolution rule, e.g. static-precedence@v1. Required when by=rule."
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Person or review-record ID. Required when by=human."
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "chosen": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "chosen",
              "by"
            ],
            "properties": {
              "chosen": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "by": {
                "const": "human"
              }
            },
            "required": [
              "by"
            ]
          },
          "then": {
            "required": [
              "reviewer"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "by": {
                "const": "rule"
              }
            },
            "required": [
              "by"
            ]
          },
          "then": {
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*@v[0-9]+$"
              }
            }
          }
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "impact",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "impact": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  }
}